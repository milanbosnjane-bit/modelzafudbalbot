# Application
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://football:football@postgres:5432/football_roi
DATABASE_URL_SYNC=postgresql://football:football@postgres:5432/football_roi

# Redis
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=3600

# API-Football (primary)
API_FOOTBALL_KEY=your_api_football_key
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# The Odds API (optional)
ODDS_API_KEY=your_odds_api_key
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4

# Weather (OpenWeatherMap)
WEATHER_API_KEY=your_weather_api_key

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id
# Više korisnika: odvojeni zarezom, npr. 123456,789012

# ROI thresholds
MIN_EV_THRESHOLD=0.015
MIN_CONFIDENCE_THRESHOLD=0.55
USE_CALIBRATED_CONFIDENCE=false
MAX_DAILY_PICKS=6
KELLY_FRACTION=0.25
DEFAULT_STAKE_METHOD=fractional_kelly

# Temporal integrity
DECISION_HOURS_BEFORE_KICKOFF=1.0
MIN_TRAINING_SAMPLES=100
TRAIN_TEST_RATIO=0.2
TRAIN_EMBARGO_DAYS=1
ALLOW_SYNTHETIC_TRAINING=false
EXCLUDE_LEGACY_TRAINING=true

# Realistic execution
BACKTEST_SLIPPAGE_PCT=0.015
PROBABILITY_SHRINK_WEIGHT=0.55

# Live mode — Poisson signal + ručno klađenje
POISSON_ONLY_MODE=true
PAPER_TRADING_ENABLED=true

# Context gates (fatigue + market + lineup)
CONTEXT_GATES_ENABLED=true
FATIGUE_GATE_ENABLED=true
MARKET_CONFIRMATION_GATE_ENABLED=false
LINEUP_GATE_ENABLED=true
MIN_TEAM_XG_THRESHOLD=0.15

# Crna lista liga (API-Football ID) — UCL isključena zbog negativnog ROI
EXCLUDE_LEAGUE_IDS=[2]

# Model paths
MODEL_DIR=./data/models
FEATURE_DIR=./data/features
